#!/bin/bash
# Runs the Calendar.js suite in timezones on both sides of Greenwich and the date
# line, since all-day placement and multi-day spans are exactly what breaks
# when a date is read as an instant.
set -e
cd "$(dirname "$0")"
for tz in UTC America/Los_Angeles Europe/Berlin Asia/Tokyo Pacific/Kiritimati; do
  TZ=$tz node calendar.test.js
  TZ=$tz node google.test.js
done
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -p 'test_*.py'
